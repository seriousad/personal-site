{
  "name": "kndg-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "playwright test",
    "social:generate": "node scripts/generate-social-card.mjs",
    "deploy": "npm run build && wrangler deploy && npm run deploy:www",
    "deploy:www": "wrangler deploy --config workers/www-redirect/wrangler.jsonc",
    "deploy:preview": "npm run build && wrangler versions upload"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
