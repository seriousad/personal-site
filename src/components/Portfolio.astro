---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import SystemDiagram from './SystemDiagram.astro';
import ProjectCard from './ProjectCard.astro';
import Capabilities from './Capabilities.astro';
import { content, profile, type Language } from '../data/profile';
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
---
<BaseLayout lang={lang}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="site-header" id="top">
    <div class="container header-inner">
      <a class="wordmark" href={lang === 'ru' ? '/ru/' : '/'} aria-label={`${t.name} — ${lang === 'ru' ? 'главная' : 'home'}`}>kndg<span class="wordmark-dot">.</span><span class="wordmark-slash">/</span></a>
      <nav class="main-nav" aria-label={lang === 'ru' ? 'Основная навигация' : 'Main navigation'}>
        <a href="#about">{t.nav.about}</a><a href="#projects">{t.nav.projects}</a><a href="#experience">{t.nav.experience}</a>
      </nav>
      <div class="header-actions">
        <nav class="language-switch" aria-label={t.language}><a href="/" lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a><span aria-hidden="true">/</span><a href="/ru/" lang="ru" hreflang="ru" aria-current={lang === 'ru' ? 'page' : undefined}>RU</a></nav>
        <button class="theme-toggle icon-button" type="button" aria-label={t.theme} aria-pressed="false" hidden><span class="theme-moon"><Icon name="moon" size={18} /></span><span class="theme-sun"><Icon name="sun" size={18} /></span></button>
        <a class="header-contact" href="#contact">{t.nav.contact}<Icon name="external" size={15} /></a>
      </div>
    </div>
  </header>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="tiny-cross">+</span>{t.hero.eyebrow}</p>
        <h1 id="hero-title"><span>{t.firstName}</span><span>{t.lastName}<span class="name-period">.</span></span></h1>
        <p class="hero-role">{profile.role}</p>
        <h2 class="hero-lead">{t.hero.lead}</h2>
        <p class="hero-description">{t.hero.text}</p>
        <ul class="hero-facts">{t.hero.facts.map(fact => <li>{fact}</li>)}</ul>
        <div class="hero-buttons"><a class="button button-primary" href={profile.telegram} target="_blank" rel="noopener noreferrer">{t.hero.cta}<Icon name="external" size={18} /></a><a class="text-link" href="#projects">{t.hero.secondary}<Icon name="down" size={17} /></a></div>
        <div class="hero-meta"><span><Icon name="pin" size={15} />{t.hero.location}</span><span class="meta-divider"></span><span><span class="status-dot"></span>{t.hero.current} <a href="https://www.ivi.ru/" target="_blank" rel="noopener noreferrer" class="ivi-wordmark">ivi<span class="sr-only"> ({lang === 'ru' ? 'новая вкладка' : 'new tab'})</span></a></span></div>
      </div>
      <div class="hero-visual"><SystemDiagram caption={t.hero.diagramCaption} /><div class="visual-sticker"><span class="sticker-symbol">↗</span><span>design. build.<br />deploy.</span></div></div>
      <a class="hero-scroll" href="#about"><span class="scroll-line"></span>{t.hero.scroll}<Icon name="down" size={14} /></a>
    </section>
    <section class="section section-about" id="about" aria-labelledby="about-title">
      <div class="container"><div class="section-heading"><p class="eyebrow">{t.about.label}</p><div><h2 id="about-title">{t.about.title}</h2><div class="about-copy"><p>{t.about.text}</p><p>{t.about.note}</p></div></div></div><Capabilities items={t.about.capabilities} /></div>
    </section>
    <section class="section container" id="projects" aria-labelledby="projects-title"><div class="section-heading"><p class="eyebrow">{t.projects.label}</p><div><h2 id="projects-title">{t.projects.title}</h2><p class="section-intro">{t.projects.intro}</p></div></div><div class="projects-grid">{t.projects.items.map(project => <ProjectCard project={project} expand={t.projects.expand} contributionLabel={t.projects.contributionLabel} />)}</div></section>
    <section class="section section-experience" id="experience" aria-labelledby="experience-title"><div class="container"><div class="section-heading"><p class="eyebrow">{t.experience.label}</p><div><h2 id="experience-title">{t.experience.title}</h2><p class="section-intro">{t.experience.intro}</p></div></div><div class="experience-list">{t.experience.items.map(item => <article class:list={['experience-row', { 'is-current': item.current }]}><div class="experience-date mono">{item.current && <span class="status-dot"></span>}{item.period}</div><div class="experience-content"><div class="experience-title"><h3>{item.company}</h3><span class="experience-role">{item.role}</span></div><p>{item.description}</p></div></article>)}</div><div class="education"><p class="eyebrow">{t.experience.educationLabel}</p><div class="education-items">{t.experience.education.map(item => <div class="education-item"><span class="mono education-year">{item.year}</span><div><h3>{item.school}</h3><p>{item.degree}</p></div></div>)}</div></div></div></section>
    <section class="section container contact-section" id="contact" aria-labelledby="contact-title">
      <div class="contact-card">
        <div class="contact-heading"><p class="eyebrow">{t.contact.label}</p><span class="contact-asterisk" aria-hidden="true">✳</span></div>
        <h2 id="contact-title">{t.contact.title}</h2>
        <p class="contact-text">{t.contact.text}</p>
        <div class="email-row"><a class="email-link" href={`mailto:${profile.email}`} aria-label={`${t.contact.email}: ${profile.email}`}>{profile.email}<Icon name="external" size={26} /></a><button class="copy-email icon-button" type="button" aria-label={t.contact.copy} data-email={profile.email} data-success={t.contact.copied} data-error={t.contact.copyError} hidden><Icon name="copy" size={19} /></button></div>
        <p class="copy-status" role="status" aria-live="polite"></p>
        <div class="contact-links">
          <a href={profile.telegram} target="_blank" rel="noopener noreferrer"><span><strong>Telegram</strong><small>{profile.telegramHandle} · {t.contact.telegram}</small></span><Icon name="external" /></a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer"><span><strong>GitHub</strong><small>{t.contact.github}</small></span><Icon name="external" /></a>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><span><strong>LinkedIn</strong><small>{t.contact.linkedin}</small></span><Icon name="external" /></a>
          <a href={`tel:${profile.phone}`}><span><strong>{profile.phoneDisplay}</strong><small>{t.contact.phone}</small></span><Icon name="external" /></a>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer container"><a class="wordmark footer-wordmark" href="#top">kndg<span class="wordmark-dot">.</span></a><p>© {year} {t.name}<span>{t.footer.note}</span></p><a class="back-top" href="#top">{t.footer.top}<Icon name="arrow" size={16} /></a></footer>
  <script>
    import '../scripts/navigation';

    const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (themeButton) {
      themeButton.hidden = false;
      themeButton.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      themeButton.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        themeButton.setAttribute('aria-pressed', String(theme === 'dark'));
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#191e1a' : '#f7f8f2');
        try { localStorage.setItem('kndg-theme', theme); } catch {}
      });
    }

    const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
    const copyStatus = document.querySelector<HTMLElement>('.copy-status');
    if (copyButton && copyStatus && navigator.clipboard) {
      copyButton.hidden = false;
      let resetTimer: ReturnType<typeof setTimeout>;
      copyButton.addEventListener('click', async () => {
        clearTimeout(resetTimer);
        try {
          await navigator.clipboard.writeText(copyButton.dataset.email ?? '');
          copyStatus.textContent = copyButton.dataset.success ?? '';
          copyButton.classList.add('is-copied');
        } catch {
          copyStatus.textContent = copyButton.dataset.error ?? '';
        }
        resetTimer = setTimeout(() => { copyStatus.textContent = ''; copyButton.classList.remove('is-copied'); }, 5000);
      });
    }

  </script>
</BaseLayout>
