{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kndg-personal-site",
  "compatibility_date": "2026-11-02",
  "routes": [
    { "pattern": "kndg.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
